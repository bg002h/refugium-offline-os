[Unit]
Description=Refugium signet test wallet
Wants=bitcoind-signet.service
After=bitcoind-signet.service systemd-user-sessions.service systemd-udev-trigger.service seatd.service
Requires=seatd.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=live
Group=live
SupplementaryGroups=video render input
LimitMEMLOCK=67108864:67108864
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
Environment=HOME=/home/live
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=LIBSEAT_BACKEND=seatd
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_CURRENT_DESKTOP=Refugium
Environment=XDG_SESSION_TYPE=wayland
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=LIBGL_ALWAYS_SOFTWARE=1
WorkingDirectory=/home/live/Sitting
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
StandardError=tty
ExecStartPre=/usr/local/libexec/signet-session-check
ExecStartPre=/usr/local/libexec/wallet-node-ready
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/weston --socket=wayland-0 --backend=drm --renderer=gl --config=/etc/refugium/weston.ini

[Install]
WantedBy=graphical.target
