+//! Scratch-only stick policy. All secret-bearing subcommands enter it before dispatch.
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::ptr;
+use std::sync::atomic::{AtomicBool, AtomicPtr, Ordering};
+
+const START: &[u8] = b"mr-sitting could not secure its memory. No secret was read. Restart the sitting stick and try again.\n";
+pub const STOP_TEXT: &str =
+    "This sitting cannot continue with its memory locked. Stopping and cleaning up.";
+const INCOMPLETE: &[u8] = b"Cleanup could not be confirmed. Power off this test stick.\n";
+const RESERVE_BYTES: usize = 1024 * 1024;
+const CHECK_BYTES: usize = 64 * 1024;
+
+// The reserve never receives application data. MCL_CURRENT pins it at startup.
+static RESERVE: AtomicPtr<libc::c_void> = AtomicPtr::new(ptr::null_mut());
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+static STOPPING: AtomicBool = AtomicBool::new(false);
+
+fn say(mut text: &[u8]) {
+    while !text.is_empty() {
+        // Static data only. No formatter, allocator or stdio mutex on this path.
+        let n = unsafe { libc::write(libc::STDERR_FILENO, text.as_ptr().cast(), text.len()) };
+        if n < 0 && unsafe { *libc::__errno_location() } == libc::EINTR {
+            continue;
+        }
+        if n <= 0 {
+            break;
+        }
+        text = &text[n as usize..];
+    }
+}
+
+pub fn refuse() -> ! {
+    say(START);
+    unsafe { libc::_exit(2) }
+}
+
+fn map(size: usize) -> *mut libc::c_void {
+    unsafe {
+        libc::mmap(
+            ptr::null_mut(),
+            size,
+            libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+            -1,
+            0,
+        )
+    }
+}
+
+pub fn harden() {
+    let zero = libc::rlimit {
+        rlim_cur: 0,
+        rlim_max: 0,
+    };
+    if unsafe { libc::setrlimit(libc::RLIMIT_CORE, &zero) } != 0
+        || unsafe { libc::prctl(libc::PR_SET_DUMPABLE, 0, 0, 0, 0) } != 0
+    {
+        refuse();
+    }
+    let reserve = map(RESERVE_BYTES);
+    if reserve == libc::MAP_FAILED
+        || unsafe { libc::mlockall(libc::MCL_CURRENT | libc::MCL_FUTURE) } != 0
+    {
+        refuse();
+    }
+    RESERVE.store(reserve, Ordering::Release);
+    ACTIVE.store(true, Ordering::Release);
+}
+
+fn request_stop() {
+    if !STOPPING.swap(true, Ordering::AcqRel) {
+        // Return only the unused reserve to the kernel. All surviving mappings stay locked,
+        // and any future mapping still has to satisfy MCL_FUTURE.
+        let reserve = RESERVE.swap(ptr::null_mut(), Ordering::AcqRel);
+        if !reserve.is_null() {
+            unsafe { libc::munmap(reserve, RESERVE_BYTES) };
+        }
+        say(STOP_TEXT.as_bytes());
+        say(b"\n");
+    }
+}
+
+pub fn stopping() -> bool {
+    STOPPING.load(Ordering::Acquire)
+}
+
+/// At a sitting input boundary the owner can still unwind and wipe its own state.
+pub fn can_continue() -> bool {
+    if stopping() {
+        return false;
+    }
+    let page = map(CHECK_BYTES);
+    if page == libc::MAP_FAILED {
+        request_stop();
+        return false;
+    }
+    unsafe { libc::munmap(page, CHECK_BYTES) };
+    true
+}
+
+/// A short allocation can finish after returning the spare headroom. The next sitting
+/// boundary observes the pending stop. If the allocator still cannot return usable
+/// storage, terminate without unlocking or claiming cleanup finished.
+pub struct StrictAlloc;
+fn allocate(f: impl Fn() -> *mut u8) -> *mut u8 {
+    let p = f();
+    if !p.is_null() {
+        return p;
+    }
+    if !ACTIVE.load(Ordering::Acquire) {
+        refuse();
+    }
+    request_stop();
+    let p = f();
+    if p.is_null() {
+        say(INCOMPLETE);
+        unsafe { libc::_exit(1) }
+    }
+    p
+}
+
+// SAFETY: all pointers are obtained, resized and freed by System using the caller's layout.
+// On failure realloc leaves the original allocation intact. No allocator call unwinds.
+unsafe impl GlobalAlloc for StrictAlloc {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        allocate(|| unsafe { System.alloc(layout) })
+    }
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        allocate(|| unsafe { System.alloc_zeroed(layout) })
+    }
+    unsafe fn realloc(&self, p: *mut u8, layout: Layout, size: usize) -> *mut u8 {
+        allocate(|| unsafe { System.realloc(p, layout, size) })
+    }
+    unsafe fn dealloc(&self, p: *mut u8, layout: Layout) {
+        unsafe { System.dealloc(p, layout) };
+    }
+}
