+static bool
+is_refugium_wallet(struct weston_desktop_surface *surface)
+{
+	const char *title = weston_desktop_surface_get_title(surface);
+	const char *app_id = weston_desktop_surface_get_app_id(surface);
+
+	return (app_id && strcmp(app_id, "mr-gui") == 0) ||
+		(title && strcmp(title, "Refugium Wallet") == 0);
+}
+
+static void
+size_refugium_wallet(struct shell_surface *shsurf)
+{
+	pixman_rectangle32_t area;
+
+	if (!shsurf->output)
+		return;
+
+	get_output_work_area(shsurf->shell, shsurf->output, &area);
+	if (area.width >= 1600 && area.height >= 800)
+		weston_desktop_surface_set_size(shsurf->desktop_surface,
+		    area.width * 57 / 100, area.height - 30);
+}
+
